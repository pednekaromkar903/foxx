{
  "name": "atomberg-goal-portal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "db:push": "pnpm --filter @atomberg/database db:push",
    "db:seed": "pnpm --filter @atomberg/database db:seed",
    "db:generate": "pnpm --filter @atomberg/database db:generate",
    "db:studio": "pnpm --filter @atomberg/database db:studio",
    "postinstall": "pnpm run db:generate",
    "prepare": "pnpm --filter @atomberg/database db:generate && pnpm --filter @atomberg/database build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^5.3.3"
  }
}
